{
  "manifest_version": 3,
  "name": "Activity Journal Browser Bridge",
  "version": "0.1.0",
  "description": "Gửi tiêu đề và hostname của tab đang active tới Activity Journal trên máy này.",
  "key": "",
  "permissions": ["tabs", "nativeMessaging"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Activity Journal",
    "default_popup": "popup.html"
  },
  "incognito": "not_allowed"
}
