{
  "name": "activity-journal",
  "version": "0.4.2",
  "private": true,
  "description": "Local-only activity journal for Windows 10/11 x64",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vietvh-3042/activity-journal.git"
  },
  "homepage": "https://github.com/vietvh-3042/activity-journal#readme",
  "bugs": {
    "url": "https://github.com/vietvh-3042/activity-journal/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "dist-electron/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"tsc -p tsconfig.electron.json --watch --preserveWatchOutput\" \"wait-on tcp:5173 dist-electron/main/index.js && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && npm run typecheck && vite build && tsc -p tsconfig.electron.json",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:helper": "dotnet publish native/ActivityJournal.Helper/ActivityJournal.Helper.csproj -c Release -r win-x64 --self-contained true -p:PublishSingleFile=true -o native/publish/win-x64",
    "test:helper": "dotnet test native/ActivityJournal.Helper.Tests/ActivityJournal.Helper.Tests.csproj",
    "dist:win": "npm run build:helper && npm run build && electron-builder --win nsis --x64",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.15.30",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^43.2.0",
    "electron-builder": "^26.0.12",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.3.5",
    "vitest": "^5.0.0",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.activityjournal.desktop",
    "productName": "Activity Journal",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "native/publish/win-x64",
        "to": "native",
        "filter": [
          "ActivityJournal.Helper.exe"
        ]
      },
      {
        "from": "extension",
        "to": "extension",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh"
    }
  }
}
